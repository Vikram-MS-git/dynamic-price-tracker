PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/price_tracker
SCRAPE_CRON=0 */6 * * *
SCRAPE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
# Retry with headless Chrome when cheerio fails (recommended for Flipkart)
SCRAPE_PUPPETEER_FALLBACK=true
# Use Puppeteer for every scrape (slower; set true if cheerio always fails)
SCRAPE_USE_PUPPETEER=false
