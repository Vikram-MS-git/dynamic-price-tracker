PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/price_tracker
SCRAPE_CRON=0 */6 * * *
SCRAPE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
# Retry with headless Chrome when cheerio fails (recommended for Flipkart)
SCRAPE_PUPPETEER_FALLBACK=true
# Use Puppeteer for every scrape (slower; set true if cheerio always fails)
SCRAPE_USE_PUPPETEER=false

# Secret used to sign login tokens (REQUIRED in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Production only: your frontend URL(s), comma separated. Leave empty for local development.
# CORS_ORIGINS=https://your-app.vercel.app

# Scraping behaviour
# Pause between products during "refresh all" / scheduled runs (milliseconds)
SCRAPE_DELAY_MS=1500
# Give up on one product after this long (milliseconds)
SCRAPE_TIMEOUT_MS=90000
